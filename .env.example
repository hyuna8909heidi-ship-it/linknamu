# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 커밋하지 않습니다)
# MongoDB Atlas > Database > Connect > Drivers 에서 연결 문자열 복사
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=linknamu

# /api/stats 조회용 비밀 토큰 (충분히 긴 임의 문자열)
STATS_TOKEN=change-me-to-a-long-random-string
